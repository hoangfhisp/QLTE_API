# ==========================================
# QLTE API - Environment Configuration Example
# ==========================================

# ASP.NET Core Runtime Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000;https://+:5001

# Database Connection Strings (SQL Server)
ConnectionStrings__AuthDb=Server=localhost,1433;Database=QLTE_AuthDb;User Id=sa;Password=YourStrongPassword123!;TrustServerCertificate=True;
ConnectionStrings__UserDb=Server=localhost,1433;Database=QLTE_UserDb;User Id=sa;Password=YourStrongPassword123!;TrustServerCertificate=True;
ConnectionStrings__ChildDb=Server=localhost,1433;Database=QLTE_ChildDb;User Id=sa;Password=YourStrongPassword123!;TrustServerCertificate=True;

# JWT Authentication Configuration
AuthOptions__Jwt__SecretKey=YourSuperSecretKeyWithMinimumLengthOf32Characters!
AuthOptions__Jwt__Issuer=QLTE_API
AuthOptions__Jwt__Audience=QLTE_Clients
AuthOptions__Jwt__ExpireMinutes=60
AuthOptions__RefreshTokenExpireDays=15

# SMTP Email Dispatcher Settings
EmailSettings__Name=QLTE System Notification
EmailSettings__Email=noreply@qlte-platform.local
EmailSettings__Host=smtp.example.com
EmailSettings__Port=587
EmailSettings__SSL=true
EmailSettings__Pass=YourSmtpAppPasswordHere

# External Identity Providers
GoogleAuth__ClientId=your-google-client-id.apps.googleusercontent.com
GoogleAuth__ClientSecret=your-google-client-secret

# Microservice & Internal Gateway Routing
ServiceUrls__UserService=https://localhost:5001

# System Role Defaults
UserSettings__DefaultRole=Parent
